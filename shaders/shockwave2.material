  name: "tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "u_in"
  type: CONSTANT_TYPE_USER
  value {
    y: -100000.0
  }
}
fragment_constants {
  name: "u_screen"
  type: CONSTANT_TYPE_USER
  value {
  }
}
