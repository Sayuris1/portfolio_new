name: "shockwave2"
tags: "shock"
vertex_program: "/builtins/materials/sprite.vp"
fragment_program: "/shaders/shockwave2.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
