go.property("text_index", 1)

function init(self)
	self.text_table = {}
	self.text = require("scripts.text")[self.text_index]

	-- Get the size of the assigned letter
	local font = go.get("#label", "font")
	local dist = 1 * go.get_scale().x

	-- Split text into lines based on "\n"
	local lines = {}
	for line in self.text:gmatch("([^\n]*)\n?") do
		if line ~= "" then
			table.insert(lines, line)
		end
	end

	-- Calculate overall height and width for centering
	local line_metrics = {}
	local overall_height = 0
	local overall_width = 0
	for _, line in ipairs(lines) do
		local width = 0
		local max_height = 0
		for j = 1, #line do
			local t = line:sub(j, j)
			local m = resource.get_text_metrics(font, t)
			width = width + (m.width or 0) * dist
			max_height = math.max(max_height, m.height or 0)
		end
		table.insert(line_metrics, {width = width, height = max_height})
		overall_height = overall_height + max_height
		overall_width = math.max(overall_width, width)
	end

	-- Place each letter
	local y_offset = go.get_position().y + overall_height / 2
	local z = go.get_position().z - 500
	for line_idx, line in ipairs(lines) do
		local line_width = line_metrics[line_idx].width
		local line_height = line_metrics[line_idx].height
		local x_offset = go.get_position().x - line_width / 2
		for i = 1, #line do
			local text = line:sub(i, i)
			table.insert(self.text_table, text)

			-- Calculate cumulative width up to current letter
			local total_width = 0
			for j = 1, i - 1 do
				local prev_text = line:sub(j, j)
				local prev_metrics = resource.get_text_metrics(font, prev_text)
				total_width = total_width + (prev_metrics.width or 0) * dist
			end

			local x = x_offset + total_width
			local y = y_offset - (overall_height - line_height) - (line_height * line_idx)
			local new = factory.create("#factory", vmath.vector3(x, y, z), nil, {queue = #self.text_table})

			local url = msg.url(new)
			url.fragment = hash("label")

			label.set_text(url, text)
		end
	end
end

