embedded_instances {
  id: "nowhere_text"
  data: "embedded_components {\n"
  "  id: \"label\"\n"
  "  type: \"label\"\n"
  "  data: \"size {\\n"
  "  x: 128.0\\n"
  "  y: 32.0\\n"
  "}\\n"
  "pivot: PIVOT_W\\n"
  "text: \\\"Developed and maintained a custom isometric particle\\\\n"
  "\\\"\\n"
  "  \\\"system aligned with the art direction.\\\\n"
  "\\\"\\n"
  "  \\\"\\\\n"
  "\\\"\\n"
  "  \\\"Optimized rendering pipelines and a custom bone-based\\\\n"
  "\\\"\\n"
  "  \\\"animation system for performance and visual fidelity.\\\\n"
  "\\\"\\n"
  "  \\\"\\\\n"
  "\\\"\\n"
  "  \\\"Built and extended production tools for\\\\n"
  "\\\"\\n"
  "  \\\"Unity, Photoshop, and Spine.\\\\n"
  "\\\"\\n"
  "  \\\"\\\\n"
  "\\\"\\n"
  "  \\\"Created real-time visual effects and improved cross-team\\\\n"
  "\\\"\\n"
  "  \\\"workflows between art and engineering.\\\"\\n"
  "font: \\\"/font/fancy_font_copy.font\\\"\\n"
  "material: \\\"/builtins/fonts/label-df.material\\\"\\n"
  "\"\n"
  "}\n"
  ""
  position {
    x: -86.66667
    y: -46.111115
  }
  scale3 {
    x: 0.07
    y: 0.07
    z: 0.07
  }
}
