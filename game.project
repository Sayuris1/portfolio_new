[bootstrap]
main_collection = /main/main.collectionc
render = /render/custom_renderer.renderc

[script]
shared_state = 1

[display]
width = 383
height = 1920
high_dpi = 1
dynamic_orientation = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = portfolio
custom_resources = videos
dependencies#0 = https://github.com/britzl/defold-input/archive/refs/tags/4.7.0.zip
dependencies#1 = https://github.com/defold/extension-videoplayer-mpeg/archive/master.zip

