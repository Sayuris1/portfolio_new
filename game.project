[bootstrap]
main_collection = /main/main.collectionc
render = /render/custom_renderer.renderc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1
dynamic_orientation = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
debug = 0
allow_dynamic_transforms = 1

[html5]
scale_mode = stretch
show_made_with_defold = 0
show_console_banner = 0
show_fullscreen_button = 0
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = portfolio
custom_resources = videos
dependencies#0 = https://github.com/britzl/defold-input/archive/refs/tags/4.7.0.zip
dependencies#1 = https://github.com/defold/extension-videoplayer-mpeg/archive/master.zip
dependencies#2 = https://github.com/defold/extension-videoplayer-mpeg/archive/master.zip

[label]
max_count = 128

